{
  "sourceLanguage": "en",
  "strings": {
    "This Mac removed the pairing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac removed the pairing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 移除了配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部 Mac 移除了配對。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac がペアリングを削除しました。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ini membuang pasangan."
          }
        }
      }
    },
    "Someone else answered this code.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone else answered this code."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他人已响应此代码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他人已回應此代碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の人がこのコードに応答しました。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang lain telah menjawab kod ini."
          }
        }
      }
    },
    "This code expired. Show a new one on your Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code expired. Show a new one on your Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此代码已过期。请在 Mac 上显示新代码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此代碼已過期。請在 Mac 上顯示新代碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードの有効期限が切れました。Mac で新しいコードを表示してください。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod ini telah tamat tempoh. Paparkan kod baharu pada Mac anda."
          }
        }
      }
    },
    "The relay is busy. Try again in a moment.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The relay is busy. Try again in a moment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中继繁忙。请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中繼忙碌中。請稍後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リレーが混雑しています。しばらくしてから再試行してください。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Geganti sibuk. Cuba lagi sebentar nanti."
          }
        }
      }
    },
    "The relay answered HTTP %lld.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The relay answered HTTP %lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中继返回 HTTP %lld。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中繼回傳 HTTP %lld。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リレーが HTTP %lld を返しました。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Geganti membalas HTTP %lld."
          }
        }
      }
    }
  },
  "version": "1.0"
}
