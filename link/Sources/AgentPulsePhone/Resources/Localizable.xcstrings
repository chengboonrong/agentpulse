            "state": "translated",
            "value": "%@が失敗しました"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gagal"
          }
        }
      }
    },
    "%@ stopped with an error.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ stopped with an error."
          }
        },
        "zh-Hans": {
