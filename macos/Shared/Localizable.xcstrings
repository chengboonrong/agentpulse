    "AgentPulse has no access to its App Group storage.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AgentPulse has no access to its App Group storage."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AgentPulse 无法访问其应用组存储空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AgentPulse 無法存取其 App 群組儲存空間。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AgentPulse はアプリグループのストレージにアクセスできません。"
