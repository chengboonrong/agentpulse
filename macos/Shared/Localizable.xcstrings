    "Pair only with a Mac you own. It will send its agents' status to this %@, end-to-end encrypted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair only with a Mac you own. It will send its agents' status to this %@, end-to-end encrypted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅与你拥有的 Mac 配对。它会通过端到端加密将智能体状态发送到此 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅與你擁有的 Mac 配對。它會透過端對端加密將代理程式狀態傳送到此 %@。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "所有する Mac とのみペアリングしてください。エージェントの状態がエンドツーエンド暗号化でこの %@ に送信されます。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasangkan hanya dengan Mac milik anda. Status ejennya akan dihantar ke %@ ini dengan penyulitan hujung ke hujung."
          }
        }
      }
    },
