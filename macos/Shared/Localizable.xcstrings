    "%@ last updated %@. It may be asleep or offline.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ last updated %@. It may be asleep or offline."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上次更新于 %@。它可能已休眠或离线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上次更新於 %@。它可能已休眠或離線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の最終更新は %@です。スリープ中かオフラインの可能性があります。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kali terakhir dikemas kini %@. Mac mungkin dalam mod tidur atau di luar talian."
          }
        }
      }
    },
    "Can't reach %@. Showing its last known status from %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach %@. Showing its last known status from %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到 %@。正在显示 %@的上次已知状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線至 %@。正在顯示 %@的上次已知狀態。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に接続できません。%@の最後に確認した状態を表示しています。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menghubungi %@. Memaparkan status terakhir yang diketahui dari %@."
          }
        }
      }
    },
