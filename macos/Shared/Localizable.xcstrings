    "Your Macs send only what's on. Alert text is end-to-end encrypted; the relay and Apple see only that an alert was sent.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Macs send only what's on. Alert text is end-to-end encrypted; the relay and Apple see only that an alert was sent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 仅发送已开启的提醒。提醒文本经过端到端加密；中继和 Apple 只能知道已发送提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 僅傳送已開啟的提示。提示文字經過端對端加密；中繼和 Apple 只能知道已傳送提示。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac はオンの項目のみ通知します。通知テキストはエンドツーエンドで暗号化され、リレーと Apple には通知が送信されたことだけが伝わります。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac anda hanya menghantar makluman yang dihidupkan. Teks makluman disulitkan hujung ke hujung; geganti dan Apple hanya tahu bahawa makluman telah dihantar."
          }
        }
      }
    }
  },
  "version": "1.0"
}
